# Copy to .env. Part 1 and the tests do not need a model or an API key.
# I used OpenRouter with the OpenAI-compatible adapter:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-5.6-luna
# For OpenAI directly: leave OPENAI_BASE_URL empty and use an OpenAI model name.
# Saved conversations and preferences (ignored by git):
HELPDESK_STORAGE_DIR=local-storage
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
